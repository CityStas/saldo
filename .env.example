# OpenRouter key. Never exposed to the browser - only the server reads it.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: several keys, comma-separated. The free tier allows 50 requests per
# day PER KEY, and when that window is spent every model answers 429 until it
# resets - hours later. With more than one key the server rotates automatically:
# on 401/403 it drops the key, on a key-wide daily limit it parks it until the
# reset and continues with the next one. `OPENROUTER_API_KEY` above is treated
# as a list of one, so a single key keeps working exactly as before.
# OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...

# Preferred model. Optional: the server discovers the free catalog on its own
# and falls back to any working model if this one is unavailable.
# Free is decided by price, not by the `:free` suffix - a zero-priced preview
# without the suffix is just as eligible. Tried first when set.
# Measured fast on the free tier (2026-09): z-ai/glm-5.2:free
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Optional hard allowlist. When set, only these models are used.
# OPENROUTER_MODELS=z-ai/glm-5.2:free,inclusionai/ling-3.0-flash-fin:free

# Optional blocklist. Useful for free models that only emit reasoning and never
# produce an answer, which the chat treats as unusable.
# OPENROUTER_MODEL_BLOCKLIST=qwen/qwen3.8-27b:free

# Port for the API server.
PORT=3001

# Optional. Outbound HTTP proxy for the server's calls to openrouter.ai.
# Only needed when the machine cannot reach OpenRouter directly. The port is
# checked at startup: if nothing is listening (VPN client not running), the
# server says so and falls back to a direct connection instead of failing every
# request.
# OUTBOUND_PROXY=http://127.0.0.1:10809

# Optional. How many free models the server probes at startup, how many at
# once, and how long it stops probing after upstream reports a spent daily
# window. A probe is a real request, so the count is small on purpose: three
# probes out of a budget of 50 per day. A probe result stays trusted for six
# hours, so re-reading the catalog does not start a new round of probes.
# PROBE_LIMIT=3
# PROBE_CONCURRENCY=4
# PROBE_BACKOFF_MS=600000

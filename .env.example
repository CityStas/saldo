# OpenRouter key. Never exposed to the browser - only the server reads it.
OPENROUTER_API_KEY=your_openrouter_key_here

# Preferred free model. The catalog id must end with `:free`.
# Optional: the server discovers the free catalog on its own and falls back to
# any working model if this one is unavailable.
OPENROUTER_MODEL=your-free-model:free

# Port for the API server.
PORT=3001

# Optional. Outbound HTTP proxy for the server's calls to openrouter.ai.
# Only needed when the machine cannot reach OpenRouter directly.
# OUTBOUND_PROXY=http://127.0.0.1:10809

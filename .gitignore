# The assistant's working directory. It holds session notes and throwaway
# probes, so it stays local.
.workbuddy-ai/

# Wrangler's local state (`worker/.wrangler/`) and the file it reads local
# secrets from. Both are machine-specific, and `.dev.vars` holds a plaintext
# copy of RELAY_TOKEN by design - exactly the thing that must never be tracked.
.wrangler/
.dev.vars
